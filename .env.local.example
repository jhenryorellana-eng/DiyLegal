# ============================================================================
# DIY Legal — Variables de entorno (plantilla)
# ----------------------------------------------------------------------------
# Copia este archivo a `.env.local` (git-ignored). TODAS las claves son
# SERVER-SIDE: nunca se exponen al cliente (doc 00 §convenciones, doc 07 §3, doc 10).
# Las claves del demo vienen enmascaradas → ROTARLAS antes de usar.
# Toda fuente nace detrás de un flag en `false` (doc 06 §4). Enciende con "true" o "1".
# ============================================================================

# --- Entorno ---------------------------------------------------------------
NODE_ENV=development

# --- Crons (Capa B) — authorizedCron (doc 07 §3) ---------------------------
INTERNAL_CRON_SECRET=

# ============================================================================
# FEATURE FLAGS — fuentes de la Capa B (doc 00, doc 09). Default: false.
# ============================================================================
FEEDS_ENABLE_FEDERAL_REGISTER=false
FEEDS_ENABLE_TRAVEL_ADVISORIES=false
FEEDS_ENABLE_VISA_BULLETIN=false
FEEDS_ENABLE_FEE_SCHEDULE=false
FEEDS_ENABLE_PROCESSING_TIMES=false
FEEDS_ENABLE_CIVICS=false
FEEDS_ENABLE_VACCINES=false
FEEDS_ENABLE_DMV=false
FEEDS_ENABLE_REAL_ID=false
FEEDS_ENABLE_ITIN=false
FEEDS_ENABLE_SELECTIVE_SERVICE=false
FEEDS_ENABLE_I94=false
FEEDS_ENABLE_LEGAL_AID=false
FEEDS_ENABLE_COUNTRY_REPORTS=false
FEEDS_ENABLE_NVC_CEAC=false

# --- Flags AAF / casos (doc 13, doc 07) ------------------------------------
AAF_ENABLE_USCIS=false
AAF_ENABLE_COURT_INTELLIGENCE=false
AAF_ENABLE_GEMINI=false
AAF_ENABLE_MOTION=false
# NUNCA true en producción (doc 13):
AAF_BYPASS_VALIDATORS=false

# ============================================================================
# SERVICIOS EXTERNOS (se aprovisionan en las fases que los usan)
# ============================================================================

# --- Gemini 2.5 Pro (Fase 2+) — doc 09 §3.5 --------------------------------
GEMINI_API_KEY=

# --- USCIS Torch API (Fase 4) — OAuth client_credentials — doc 09 ----------
USCIS_API_ENV=sandbox
USCIS_TORCH_CLIENT_ID=
USCIS_TORCH_CLIENT_SECRET=
USCIS_MOCK=true

# --- Worker: navegador + captcha (Fase 5/6/7) — doc 09 §14 -----------------
# El worker corre FUERA de Vercel (contenedor long-running).
HYPERBROWSER_API_KEY=
CAPTCHA_PROVIDER=2captcha
TWOCAPTCHA_API_KEY=
CAPMONSTER_API_KEY=
PROXY_URL=

# --- Supabase (Capa A, Fase 3) — doc 08 ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Fase 9) — doc 07 §4.7 -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Notificaciones (Fase 9) — Resend --------------------------------------
RESEND_API_KEY=
